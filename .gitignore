# Dependencies
node_modules/

# Build outputs and release artifacts
dist/
build/
release/
out/
*.vsix
vscode/dist/
vscode/webview-dist/
.vscode-test/

# Local data & storage (prevent committing sensitive account tokens)
.storage_data/
gitman_accounts.json
gitmulti_accounts.json

# Environment secrets
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Runtime and temporary files
*.pid
*.seed
*.tmp
*.temp

# Operating system files
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# Editor settings (preserve launch/tasks configurations for F5 debug)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.sublime-project
*.sublime-workspace

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Test and coverage output
coverage/

# TypeScript build cache
*.tsbuildinfo
