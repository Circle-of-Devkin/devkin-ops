{
  "name": "devkin-ops",
  "version": "0.1.0",
  "description": "Open-source multi-account GitHub manager and developer productivity desktop application.",
  "main": "build/electron/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && electron . --no-sandbox",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "release": "npm run dist"
  },
  "keywords": [
    "github",
    "git",
    "multi-account",
    "gui",
    "electron",
    "react"
  ],
  "author": "Circle of Devkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Circle-of-Devkin/devkin-ops.git"
  },
  "bugs": {
    "url": "https://github.com/Circle-of-Devkin/devkin-ops/issues"
  },
  "homepage": "https://github.com/Circle-of-Devkin/devkin-ops#readme",
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "lucide-react": "^1.53.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^7.0.2",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "org.circleofdevkin.devkinops",
    "productName": "DevKin Ops",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "build/electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
